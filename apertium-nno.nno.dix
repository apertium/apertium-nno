<pardef n="aft" c="NPK prefers aftan">
  <e c="NPK"> <p><l>aft</l><r>aft</r></p></e>
  <e c="v:">  <p><l>eft</l><r>aft</r></p><par n="v:aftan_eftan.vok-a2e"/></e>
</pardef>
<pardef n="alter" c="NPK prefers alter">
  <e c="NPK"> <p><l>alter</l><r>alter</r></p></e>
  <e c="v:">  <p><l>altar</l><r>alter</r></p><par n="v:alter_altar.vok-a2e"/></e>
