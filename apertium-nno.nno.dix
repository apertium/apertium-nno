  <e c="v:">  <p><l>mens</l> <r>mens</r></p><par n="v:medan_mens.syn"/></e>
</pardef>
<pardef n="skyld" c="NPK prefers skyld for debt, skuld for accusation. We keep -y- in lemma where no ambiguity.
                     Exception: always -y in unnskylde">
  <e c="gjeld"><p><l>skyld</l><r>skyld</r></p></e>
  <e r="LR">   <p><l>skuld</l><r>skyld</r></p></e>
</pardef>
<pardef n="skuld" c="NPK prefers skyld for debt, skuld for accusation. We keep -y- in lemma where no ambiguity.
                     Exception: always -y in unnskylde">
  <e r="LR">    <p><l>skyld</l><r>skyld</r></p></e>
