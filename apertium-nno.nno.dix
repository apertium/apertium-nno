</pardef>
<pardef n="jern" c="NPK prefers jern">
  <e c="NPK"> <p><l>jern</l><r>jern</r></p></e>
  <e c="v:">  <p><l>jarn</l><r>jern</r></p><par n="v:jern_jarn.vok-a2e"/></e>
</pardef>
<pardef n="kvalp" c="NPK prefers kvalp">
  <e c="NPK"> <p><l>kvalp</l><r>kvalp</r></p></e>
  <e c="v:">  <p><l>kvelp</l><r>kvalp</r></p><par n="v:kvalp_kvelp.vok-a2e"/></e>
</pardef>
<pardef n="anten" c="NPK prefers anten">
  <e c="NPK"> <p><l>anten</l><r>anten</r></p></e>
  <e c="v:">  <p><l>enten</l><r>anten</r></p><par n="v:anten_enten.vok-a2e"/></e>
