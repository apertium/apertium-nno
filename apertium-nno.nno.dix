  <e c="v:">  <p><l></l>   <r>s</r></p><par n="v:styresmakt_styremakt.stav"/></e>
</pardef>
<pardef n="ss__gs" c="trussel-/trugsel-; NPK prefers trussel-">
  <e c="NPK"> <p><l>ss</l><r>ss</r></p></e>
  <e c="v:">  <p><l>gs</l><r>ss</r></p><par n="v:true_truge.stav"/></e>
</pardef>
<pardef n="g__" c="truande/trugande; NPK prefers truande">
