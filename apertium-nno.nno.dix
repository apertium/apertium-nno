  <e c="v:">  <p><l>n</l><r>nn</r></p><par n="v:venn_ven.kons-mm2m"/></e>
</pardef>
<pardef n="__m" c="nærast/nærmast; NPK prefers nærast">
  <e c="NPK"> <p><l></l><r></r></p></e>
  <e c="v:">  <p><l>m</l><r></r></p><par n="v:nærare_nærmare.stav"/></e>
</pardef>
