</pardef>
<pardef n="e_i" c="NPK prefers segle and ekorn">
  <e c="NPK"> <p><l>e</l><r>e</r></p></e>
  <e c="v:">  <p><l>i</l><r>e</r></p><par n="v:segle_sigle.vok-e2i"/></e>
