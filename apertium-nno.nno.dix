  <e c="v:">  <p><l>mm</l>                 <r>mj</r></p><par n="v:fremje_fremme.kons-mj2mm"/></e>
</pardef>
<pardef n="hemm" c="NPK prefers hemme, hemming">
  <e c="NPK"> <p><l>hemm</l>                 <r>hemm</r></p></e>
  <e c="v:">  <p><l>hemj</l>                 <r>hemm</r></p><par n="v:hemme_hemje.kons-mm2mj"/></e>
</pardef>
<pardef n="gremm" c="NPK prefers gremme">
  <e c="NPK"> <p><l>gremm</l>                 <r>gremm</r></p></e>
  <e c="v:">  <p><l>gremj</l>                 <r>gremm</r></p><par n="v:gremme_gremje.kons-mm2mj"/></e>
</pardef>
<pardef n="fore_føre" c="NPK prefers for(e)-, foredag (føredrag)">
  <e c="NPK"> <p><l>fore</l>                 <r>fore</r></p></e>
  <e c="NPK"> <p><l>for</l>                  <r>for</r></p></e>
  <e c="v:">  <p><l>føre</l>                 <r>fore</r></p><par n="v:formål_føremål.afx-fore2føre"/></e>
  <e c="v:">  <p><l>føre</l>                 <r>for</r></p><par n="v:formål_føremål.afx-fore2føre"/></e>
</pardef>
<pardef n="ning_ing" c="NPK prefers -ning, forvaltning (forvalting)">
  <e c="NPK"> <p><l>ning</l>                 <r>ning</r></p></e>
  <e c="v:">  <p><l>ing</l>                  <r>ning</r></p><par n="v:forvaltning_forvalting.afx-ning2ing"/></e>
</pardef>
<pardef n="sels_sle" c="NPK prefers sels- (redselsfull/redslefull, vigsel(s)attest/vigsleattest)">
  <e c="NPK"> <p><l>sels</l><r>sels</r></p></e>
  <e c="NPK"> <p><l>sel</l><r>sel</r></p></e>
  <e c="v:">  <p><l>sle</l><r>sels</r></p><par n="v:redsel_redsle.kons-sel2sle"/></e>
  <e c="v:">  <p><l>sle</l><r>sel</r></p><par n="v:redsel_redsle.kons-sel2sle"/></e>
</pardef>

<pardef n="me_vi">
  <e>       <p><l>me</l> <r>vi</r></p></e>
  <e c="v:"><p><l>vi</l> <r>vi</r></p><par n="v:me_vi"/></e>
</pardef>

<pardef n="kopling_LR_kobling" c="common spelling error">
  <e>                    <p><l>kopling</l><r>kopling</r></p></e>
  <e r="LR">             <p><l>kobling</l><r>kopling</r></p></e>
</pardef>
<pardef n="stilling" c="common spelling error, except for «tilstelling»">
  <e>                    <p><l>stilling</l><r>stilling</r></p></e>
  <e r="LR">             <p><l>stelling</l><r>stilling</r></p></e>
</pardef>

<!--                      -->
<!-- END spelling choices -->
<!--                      -->


    <!-- Punctuation -->
<pardef n="numeros">
  <!-- separate out the number 1 as singular (fortunately "1.00" is usually plural!) -->
  <e>       <re>1( ?%)?</re><p><l></l>                   <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p></e>
  <e>       <re>[02-9]+( ?%)?</re><p><l></l>             <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <re>[0-9][0-9]+( ?%)?</re><p><l></l>         <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <re>[0-9]+([., ][0-9]+)+( ?%)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <e>       <re>[0-9]+([., ][0-9]+)* (tusen|[mb]illi(on|ard)ar)</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <e>       <re>[½¹²³¼¾]</re><p><l></l>                 <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <!-- Numbers from 1000 to 2200 (or 20-99) might be years. Other numbers don't get to be years.
       Noun tagging would be better, but that doesn’t work with compounding
       since inconditional numerals override the unknown-analysis. -->
  <e c="date"><re>1[0-9][0-9][0-9]|2[0-2][0-9][0-9]|[2-9][0-9]</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="date"/></r></p></e>
  <e c="section"><re>[0-9]+[\-][0-9]+</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p></e>

  <e>       <re>1</re><p><l></l>                        <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p>  <par n="."/></e>
  <e>       <re>[02-9]</re><p><l></l>                   <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p>  <par n="."/></e>
  <e>       <re>[0-9][0-9]+([., ][0-9]+)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p>  <par n="."/></e>
  <e>       <re>[0-9][., ][0-9]+</re><p><l></l>         <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p>  <par n="."/></e>
</pardef>

<pardef n="detpos-m" c="determinativ possessiv">
  <e><i>sin</i></e>
  <e><i>min</i></e>
  <e><i>din</i></e>
  <e><i>hans</i></e>
  <e><i>hennar</i></e>
  <e><i>vår</i></e>
</pardef>

<pardef n="detpos-f" c="determinativ possessiv">
  <e><i>si</i></e>
  <e><i>mi</i></e>
  <e><i>di</i></e>
  <e><i>hans</i></e>
  <e><i>hennar</i></e>
  <e><i>vår</i></e>
</pardef>

<pardef n="detpos-nt" c="determinativ possessiv">
  <e><i>sitt</i></e>
  <e><i>mitt</i></e>
  <e><i>ditt</i></e>
  <e><i>hans</i></e>
  <e><i>hennar</i></e>
  <e><i>vårt</i></e>
</pardef>

<pardef n="separa">
  <e>       <p><l>..</l><r>..<s n="sent"/><s n="clb"/></r></p></e>
  <e>       <p><l>...</l><r>...<s n="sent"/><s n="clb"/></r></p></e>
  <e>       <re>[.\?;:!…¿¶]</re><p><l></l><r><s n="sent"/><s n="clb"/></r></p></e>
</pardef>

<pardef n="coma">
  <e>       <p><l>,</l><r>,<s n="cm"/><s n="clb"/></r></p></e>
  <e>       <p><l>,</l><r>,<s n="cm"/></r></p></e>
  <e>       <p><l>/</l><r>/<s n="cm"/></r></p></e>
</pardef>

<pardef n="aposchar">
  <e>       <p><l>’</l>     <r>’</r></p></e>
  <e>       <p><l>'</l>     <r>’</r></p><par n="v:apos_fot.teikn"/></e>
</pardef>

<pardef n="cometa">
  <e>       <par n="aposchar"/><p><l></l><r><s n="apos"/></r></p></e>
  <e c="foot"><p><l>'</l>     <r>'<s n="n"/><s n="m"/><s n="pl"/><s n="ind"/></r></p></e>
  <e>       <p><l>«</l><r>«<s n="lquot"/></r></p></e>
  <e>       <p><l>»</l><r>»<s n="rquot"/></r></p></e>
  <e>       <p><l>“</l><r>“<s n="lquot"/></r></p></e>
  <e>       <p><l>”</l><r>”<s n="rquot"/></r></p></e>
  <e>       <p><l>"</l><r>“<s n="lquot"/></r></p><par n="v:sitat_tomme.teikn"/></e>
  <e>       <p><l>"</l><r>”<s n="rquot"/></r></p><par n="v:sitat_tomme.teikn"/></e>
  <e>       <p><l>”<b/></l><r>”<b/><s n="rquot"/></r></p></e> <!-- help disambig: with following space it can only be rquot -->
  <e>       <p><l>"<b/></l><r>”<b/><s n="rquot"/></r></p><par n="v:sitat_tomme.teikn"/></e>
</pardef>

<pardef n="paresq">
  <e>       <re>[\(\[{]</re><p><l></l><r><s n="lpar"/></r></p></e>
</pardef>

<pardef n="pardret">
  <e>       <re>[\)\]}]</re><p><l></l><r><s n="rpar"/></r></p></e>
</pardef>


    <!-- Numbers -->
<pardef n="ei/n__num">
  <e>       <p><l></l>  <r>n<s n="det"/><s n="qnt"/><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l>n</l> <r>n<s n="det"/><s n="qnt"/><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l>t</l> <r>n<s n="det"/><s n="qnt"/><s n="nt"/><s n="sg"/></r></p></e>
</pardef>
<pardef n="halv/annan__num">
  <e>       <p><l>annan</l>        <r>annan<s n="det"/><s n="qnt"/><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l>anna</l>         <r>annan<s n="det"/><s n="qnt"/><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l>tanna</l>        <r>annan<s n="det"/><s n="qnt"/><s n="nt"/><s n="sg"/></r></p></e>
</pardef>
<pardef n="to__num">
  <e>       <p><l></l>          <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <par n="sju__n_cmp"/></e>
</pardef>
<pardef n="eine__num">
  <e>       <p><l></l>          <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/><s n="def"/></r></p></e>
</pardef>

<pardef n="em-dash" c="allow minus">
  <e>       <p><l>–</l><r>–</r></p></e>
  <e r="LR"><p><l>-</l><r>–</r></p></e>
</pardef>

<pardef n="to-ni">
  <e r="LR"><p><l>tvo</l>  <r>to</r></p></e>
  <e><i>to</i></e>
  <e r="LR"><p><l>tri</l>  <r>tre</r></p></e>
  <e><i>tre</i></e>
  <e><i>fire</i></e>
  <e><i>fir</i></e>
  <e><i>fem</i></e>
  <e><i>seks</i></e>
  <e><i>sju</i></e>
  <e><i>åtte</i></e>
  <e><i>ni</i></e>
</pardef>
<pardef n="ein-ni" c="Not for use in plain det.qnt – ein should have m/f/nt variants">
  <e><i>ein</i></e>
  <e><par n="to-ni"/></e>
</pardef>

<pardef n="tjue-nitti">
  <e r="LR"><p><l>tyve</l><r>tjue</r></p></e>
  <e>  <i>tjue</i></e>
  <e r="LR"><p><l>tredve</l><r>tretti</r></p></e>
  <e><i>tretti</i></e>
  <e> <i>førti</i></e>
  <e> <i>femti</i></e>
  <e><i>seksti</i></e>
  <e r="LR"><p><l>søtti</l><r>sytti</r></p></e>
  <e> <i>sytti</i></e>
  <e>  <i>åtti</i></e>
  <e> <i>nitti</i></e>
</pardef>

<pardef n="to-hundre" c="No empty transition! TODO: include tjue-eitt/ei?">
  <e> <par n="to-ni"/> </e>
  <e>  <par n="tjue-nitti"/></e>
  <e>  <par n="tjue-nitti"/><par n="ein-ni"/></e>
  <e><i>null</i></e>
  <e><i>ti</i></e>
  <e><i>elleve</i></e>
  <e><i>tolv</i></e>
  <e><i>tretten</i></e>
  <e><i>fjorten</i></e>
  <e><i>femten</i></e>
  <e><i>seksten</i></e>
  <e><i>sytten</i></e>
  <e r="LR"><p><l>søtten</l><r>sytten</r></p></e>
  <e><i>atten</i></e>
  <e><i>nitten</i></e>
  <e><i>hundre</i></e>
  <e><i>tusen</i></e>
  <e><i>million</i></e>
  <e><i>milliard</i></e>
</pardef>

<pardef n="ein-hundre" c="Not for use in plain det.qnt – ein/halvannan should have m/f/nt variants">
  <e> <par n="to-hundre"/> </e>
  <e><i>ein</i></e>
  <!--e><i>halvannan</i></e-->
  <e>  <par n="tjue-nitti"/><i>ein</i></e>
</pardef>

<pardef n="første-niande">
  <e><i>f</i><par n="ø_y"/><i>rste</i></e>
  <e r="LR"><p><l>første</l><r>fyrste</r></p></e>
  <e><i>andre</i></e>
  <e><i>tredje</i></e>
  <e><i>fjerde</i></e>
  <e><i>femte</i></e>
  <e><i>sjette</i></e>
  <e><i>sjuande</i></e>
  <e><i>åttande</i></e>
  <e><i>niande</i></e>
</pardef>

<pardef n="tiande-nittande">
  <e><i>tiande</i></e>
  <e><i>ellevte</i></e>
  <e><i>tolvte</i></e>
  <e><i>trettande</i></e>
  <e><i>fjortande</i></e>
  <e><i>femtande</i></e>
  <e><i>sekstande</i></e>
  <e><i>syttande</i></e>
  <e><i>attande</i></e>
  <e><i>nittande</i></e>
</pardef>

<pardef n="tjuande-nittiande">
  <e>  <i>tjuande</i></e>
  <e>  <i>trettiande</i></e>
  <e>  <i>førtiande</i></e>
  <e>  <i>femtiande</i></e>
  <e>  <i>sekstiande</i></e>
  <e>  <i>syttiande</i></e>
  <e>  <i>åttiande</i></e>
  <e>  <i>nittiande</i></e>
</pardef>

<pardef n="første-hundrede" c="No empty transition!">
  <e>  <par n="første-niande"/> </e>
  <e>  <par n="tiande-nittande"/> </e>
  <e>  <par n="tjuande-nittiande"/></e>
  <e>  <par n="tjue-nitti"/><par n="første-niande"/></e>
  <e><i>nullte</i></e>
  <e><i>hundrede</i></e>
  <e><i>tusande</i></e>
  <e><i>millionte</i></e>
  <e><i>milliardte</i></e>
</pardef>

<!-- Pronouns -->
<pardef n="det+prn_pos">
  <e>         <p><l></l>  <r><s n="prn"/><s n="pos"/></r></p></e>
  <e>         <p><l></l>  <r><s n="det"/><s n="pos"/></r></p></e>
</pardef>
<pardef n="dets__det+prn_pos">
  <e>       <p><l></l> <r></r></p><par n="det+prn_pos"/><p><l></l><r><s n="un"/><s n="pl"/></r></p></e>
  <e>       <p><l></l> <r></r></p><par n="det+prn_pos"/><p><l></l><r><s n="nt"/><s n="sg"/></r></p></e>
  <e>       <p><l></l> <r></r></p><par n="det+prn_pos"/><p><l></l><r><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l></l> <r></r></p><par n="det+prn_pos"/><p><l></l><r><s n="m"/><s n="sg"/></r></p></e>
</pardef>

<pardef n="/eg__prn">
  <e>       <p><l>eg</l>  <r>eg<s n="prn"/><s n="pers"/><s n="p1"/><s n="mf"/><s n="sg"/><s n="nom"/></r></p></e>
  <e>       <p><l>meg</l>  <r>eg<s n="prn"/><s n="pers"/><s n="p1"/><s n="mf"/><s n="sg"/><s n="acc"/></r></p></e>
  <e>       <p><l>mi</l>  <r>min</r></p><par n="det+prn_pos"/><p><l></l><r><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l>min</l>  <r>min</r></p><par n="det+prn_pos"/><p><l></l><r><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l>mine</l> <r>min</r></p><par n="det+prn_pos"/><p><l></l><r><s n="un"/><s n="pl"/></r></p></e>
  <e>       <p><l>mitt</l>  <r>min</r></p><par n="det+prn_pos"/><p><l></l><r><s n="nt"/><s n="sg"/></r></p></e>
</pardef>

<pardef n="d/u__prn">
  <e>       <p><l>u</l>   <r>u<s n="prn"/><s n="pers"/><s n="p2"/><s n="mf"/><s n="sg"/><s n="nom"/></r></p></e>
  <e>       <p><l>eg</l>  <r>u<s n="prn"/><s n="pers"/><s n="p2"/><s n="mf"/><s n="sg"/><s n="acc"/></r></p></e>
  <e>       <p><l>i</l>   <r>in</r></p><par n="det+prn_pos"/><p><l></l><r><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l>in</l>  <r>in</r></p><par n="det+prn_pos"/><p><l></l><r><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l>ine</l> <r>in</r></p><par n="det+prn_pos"/><p><l></l><r><s n="un"/><s n="pl"/></r></p></e>
  <e>       <p><l>itt</l> <r>in</r></p><par n="det+prn_pos"/><p><l></l><r><s n="nt"/><s n="sg"/></r></p></e>
</pardef>

<pardef n="/du_dykkar__prn">
  <e>       <p><l>du/de</l>       <r>du/de<s n="prn"/><s n="pers"/><s n="p2"/><s n="un"/><s n="pl"/><s n="nom"/></r></p></e>
  <e>       <p><l>deg/de</l>      <r>du/de<s n="prn"/><s n="pers"/><s n="p2"/><s n="un"/><s n="pl"/><s n="acc"/></r></p></e>
  <e>       <p><l>di/dykkar</l>   <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="f"/><s n="sg"/></r></p></e>
  <e>       <p><l>din/dykkar</l>  <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="m"/><s n="sg"/></r></p></e>
  <e>       <p><l>dine/dykkar</l> <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="un"/><s n="pl"/></r></p></e>
  <e>       <p><l>ditt/dykkar</l> <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="nt"/><s n="sg"/></r></p></e>
  <e c="v:"><p><l>du/dokker</l>   <r>du/de<s n="prn"/><s n="pers"/><s n="p2"/><s n="un"/><s n="pl"/><s n="nom"/></r></p><par n="v:de_dokker.prn"/></e>
  <e c="v:"><p><l>deg/dokker</l>  <r>du/de<s n="prn"/><s n="pers"/><s n="p2"/><s n="un"/><s n="pl"/><s n="acc"/></r></p><par n="v:de_dokker.prn"/></e>
  <e c="v:"><p><l>di/dokkar</l>   <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="f"/><s n="sg"/></r></p><par n="v:de_dokker.prn"/></e>
  <e c="v:"><p><l>din/dokkar</l>  <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="m"/><s n="sg"/></r></p><par n="v:de_dokker.prn"/></e>
  <e c="v:"><p><l>dine/dokkar</l> <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="un"/><s n="pl"/></r></p><par n="v:de_dokker.prn"/></e>
  <e c="v:"><p><l>ditt/dokkar</l> <r>din/dykkar</r></p><par n="det+prn_pos"/><p><l></l><r><s n="nt"/><s n="sg"/></r></p><par n="v:de_dokker.prn"/></e>
</pardef>

<pardef n="h/an__prn">
  <e>       <p><l>an</l>  <r>an<s n="prn"/><s n="pers"/><s n="p3"/><s n="m"/><s n="sg"/><s n="nom"/></r></p></e>
  <e r="LR"><p><l>onom</l><r>an<s n="prn"/><s n="pers"/><s n="p3"/><s n="m"/><s n="sg"/><s n="acc"/></r></p></e>
  <e>       <p><l>an</l>  <r>an<s n="prn"/><s n="pers"/><s n="p3"/><s n="m"/><s n="sg"/><s n="acc"/></r></p></e>
  <e>       <p><l>ans</l> <r>ans</r></p><par n="dets__det+prn_pos"/></e>
</pardef>

