<section id="regex" type="standard">
  <!-- a-z* regexes lead to blow-up (2M → 15M) when in main section, keep them here: -->

  <!-- G20, F-35, RAV4 etc. -->
  <e lm="G20">    <re>[A-ZÆØÅ]+\-?[0-9][0-9A-ZÆØÅ]*</re><par n="ep_\-__n"/></e>
  <e lm="A-Z"> <re>[A-Z]</re><par n="d'or__np"/></e>
  <e lm="A-ZS"> <re>[A-Z]S</re><par n="d'or__np"/></e> <!-- since A-Z<gen> matches "AS" and generates "As" -->

  <!-- Lovparagrafar: -->
  <e lm="§ 3a">            <re>§+</re> <i><b/></i> <re>[0-9]+[0-9\-]*[a-zæøå]*</re><par n="bo_\-__n"/></e>
  <e lm="§§ 3-3 og 3-3a">  <re>§+</re> <i><b/></i> <re>[0-9]+[0-9\-]*[a-zæøå]*</re> <i><b/>og<b/></i> <re>[0-9]+[0-9\-]*[a-zæøå]*</re><par n="bo_\-__n"/></e>

  <!-- Talakronym (minst eitt siffer midt i, nøyaktig éin bokstav til sist – ikkje fleire, då overstyrer me gode samansetjingar a la 40-åra): -->
  <e lm="44b, B52-a">            <re>[A-ZÆØÅ]*[0-9]+[0-9\-]*[a-zæøå]</re><par n="bo_\-__n"/></e>
  <!-- Viss me ikkje har bindestrek kan me ha fleire bokstavar til sist (overstyrer ikkje lenger samansetjingsanalyse): -->
  <e lm="44xyz">            <re>[A-ZÆØÅ]*[0-9]+[a-zæøå]+</re><par n="bo_\-__n"/></e>

  <!-- initials: H.C. Andersen -->
  <e lm="A-Å."> <par n="A-Å."/><par n="initial__np"/></e>
  <e lm="A-Å.A-Å."> <par n="A-Å."/><par n="A-Å."/><par n="initial__np"/></e>
  <e lm="A-Å.A-Å.A-Å."> <par n="A-Å."/><par n="A-Å."/><par n="A-Å."/><par n="initial__np"/></e>

  <e lm="alphabet">        <par n="letter"/><par n="/alphabet__n"/></e>

  <e lm="AZ-basert"> <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><i>basert</i><par n="minst__adj"/></e>
  <e lm="AZ-ulykke"> <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><i>ul</i><par n="y_u"/><i>kk</i><par n="lø/e_\s__n"/></e>
  <e lm="0-9-årig"> <re>[0-9]+</re><i>-årig</i><par n="minst__adj"/></e>

  <!-- For generating forms that were "analysed" by CG -->
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><par n="cgguess__np"/></e>
  <!-- For generating forms that were "analysed" by merge-names.rlx: -->
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><i><b/></i><par n="upper"/><par n="letterdash*"/><par n="letterdot-sgen"/><par n="cgguess__np"/></e>
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><i><b/></i><par n="upper"/><par n="letterdash*"/><par n="letterdot-'gen"/><par n="cgguess'__np"/></e>
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><i><b/></i><par n="upper"/><par n="letterdashdot*"/><i><b/></i><par n="upper"/><par n="letterdash*"/><par n="letterdot-sgen"/><par n="cgguess__np"/></e>
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><i><b/></i><par n="upper"/><par n="letterdashdot*"/><i><b/></i><par n="upper"/><par n="letterdash*"/><par n="letterdot-'gen"/><par n="cgguess'__np"/></e>
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><i><b/></i><par n="upper"/><par n="letterdashdot+"/><i><b/></i><par n="upper"/><par n="letterdashdot*"/><i><b/></i><par n="upper"/><par n="letterdash*"/><par n="letterdot-sgen"/><par n="cgguess__np"/></e>
  <e r="RL" lm="np cgguess regex"><par n="letterdash+"/><i><b/></i><par n="upper"/><par n="letterdashdot+"/><i><b/></i><par n="upper"/><par n="letterdashdot*"/><i><b/></i><par n="upper"/><par n="letterdash*"/><par n="letterdot-'gen"/><par n="cgguess'__np"/></e>

  <!-- For analysing name-compound-parts ending in dash (letting the second part be looked up in .dix, something CG can't do): -->
  <!-- not using letter pardefs since that makes the final transducer huge -->
  <e lm="np-guio regex"><re>[A-ZÆØÅ][a-zæøå]+\-</re><p><l/><r><s n="np"/><s n="guess"/></r></p><par n="cp-guio"/></e>
  <e lm="np-guio regex"><re>[A-ZÆØÅ][A-ZÆØÅ]+\-</re><p><l/><r><s n="np"/><s n="guess"/></r></p><par n="cp-guio"/></e>
  <e lm="np-apos regex"><re>[A-ZÆØÅ][A-ZÆØÅa-zæøå\-]+[SZXszx]</re><par n="aposchar"/><p><l/><r><s n="np"/><s n="guess"/><s n="gen"/></r></p></e>

  <!-- Numbers are *not* in inconditional, since that would block compounding with them: -->
  <e>                      <par n="numeros"/></e>

  <!-- To get things like «MAX 8-fly» as two tokens instead of four (though one would be even better): -->
  <e lm="0-9+">        <re>[0-9]([0-9–\-]*[0-9])?</re><par n="8__n_cmp"/></e>


  <!-- 22.30-tiden needs a non-compund entry, otherwise it gets tokenised
       as 22.<adj><ord>-<guio>tid<n> since the adj.ord are inconditional:-->
  <e lm="22.30-tiden">          <re>[0-9]+[.][0-9]+</re><i>-tid</i><par n="å_\s__n"/></e>
  <e lm="13.-plass">            <re>[0-9]+[.]</re><i>-plass</i><par n="pels__n"/></e>
  <e lm="13.-klassing">         <re>[0-9]+[.]</re><i>-klassing</i><par n="ep__n"/></e>
  <e lm="13.-omgang">           <re>[0-9]+[.]</re><i>-omgang</i><par n="ep__n"/></e>
  <e lm="13.-divisjon">         <re>[0-9]+[.]</re><i>-divisjon</i><par n="ep_\s__n"/></e>
  <e lm="13.-divisjonavdeling"> <re>[0-9]+[.]</re><i>-divisjonsavdeling</i><par n="yting_\s__n"/></e>
  <e lm="13.-lag">              <re>[0-9]+[.]</re><i>-lag</i><par n="ty__n"/></e>
  <e lm="13-månadersalder">    <re>[0-9–—\-]+</re><i>-månadersald</i><par n="ot/er__n"/></e>
  <e lm="13-punkts">     <re>[0-9]+</re><i>-punkt</i><par n="ty_\s__n"/></e>
  <e lm="13-dagars">     <re>[0-9]+</re><i>-dagars</i><par n="kommunal__n_cmp"/></e>
  <!-- And a non-compound (but cmp-tagged) entry for the general case to analyse
       things like «1.000-kroneseddel» as ^1.<n><cmp>$^000<n><cmp>$^seddel<n>$,
       but without using the compound machinery (which would be overridden by inconditionals): -->
  <e lm="0-9+." c="2-3-seier">        <re>[0-9]+[.]</re><p><l></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></r></p></e>

  <e lm="foo.com"> <re>(https?://|[a-z0-9\-_.\+]+@)?(www.)?([A-Za-zæøå0-9\-_]+[.])+(com|no|net|co[.]uk|fr|se|biz|dk|gov|org|nz|uk|eu|ie|ch|ru)+(/[a-zæøå0-9\-_/]*)?</re><p><l></l><r><s n="url"/></r></p></e>

  <!-- used in fao-nob: -->
  <e r="RL" lm="regex"><re>[A-Z][a-z]+</re><p><l></l><r><s n="np"/><s n="guess"/></r></p></e>
</section>

<section id="final" type="inconditional">
  <e>                      <par n="separa"/></e>
  <e>                      <par n="coma"/></e>
  <e>                      <par n="cometa"/></e>
  <e>                      <par n="paresq"/></e>
  <e>                      <par n="pardret"/></e>
  <e><p><l>-</l><r>-<s n="guio"/></r></p></e>
  <e><p><l>–</l><r>–<s n="guio"/><s n="clb"/></r></p></e> <!-- en dash -->
  <e><p><l>—</l><r>—<s n="guio"/><s n="clb"/></r></p></e> <!-- em dash -->

  <e lm="[0-9]+.">         <re>[0-9]+</re><i>.</i><par n="1.__adj"/></e>

  <e>     <p><l>❡</l><r>❡<s n="sent"/><s n="clb"/></r></p></e>
  <e>     <p><l>@</l><r>@<s n="guio"/></r></p></e>
</section>

</dictionary>
