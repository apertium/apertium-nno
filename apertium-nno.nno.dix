<pardef n="spenn" c="NPK prefers spennande">
  <e c="NPK"> <p><l>spenn</l><r>spenn</r></p></e>
  <e c="v:">  <p><l>span</l><r>spenn</r></p><par n="v:spenn_span.vok-a2e"/></e>
