  <e c="v:">  <p><l>t</l><r>tt</r></p><par n="v:kjøtt_kjøt.kons-mm2m"/></e>
  <e c="v:">  <p><l>t</l><r>tt</r></p><par n="v:venn_ven.kons-mm2m"/></e>
</pardef>
<pardef n="kk_k_sub" c="kjøkken/kjøken; NPK prefers kjøkken">
