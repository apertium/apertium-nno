<pardef n="n_er" c="døgn/døger; NPK prefers døgn">
  <e c="NPK"> <p><l>n</l>  <r>n</r></p></e>
  <e c="v:">  <p><l>er</l>   <r>n</r></p><par n="v:døgn_døger.stav"/></e>
</pardef>
<pardef n="n__" c="augne-/auge-; NPK prefers augne-">
  <e c="NPK"> <p><l>n</l>  <r>n</r></p></e>
  <e c="v:">  <p><l></l>   <r>n</r></p><par n="v:augne_auge.stav"/></e>
</pardef>
<pardef n="nj_n" c="linje/line; NPK prefers linje">
  <e c="NPK"> <p><l>nj</l>  <r>nj</r></p></e>
  <e c="v:">  <p><l>n</l>   <r>nj</r></p><par n="v:linje_line.stav"/></e>
</pardef>
<pardef n="ud_ur" c="brud/brur; NPK prefers brud">
  <e c="NPK"> <p><l>ud</l>  <r>ud</r></p></e>
  <e c="v:">  <p><l>ur</l>   <r>ud</r></p><par n="v:brud_brur.stav"/></e>
</pardef>
<pardef n="symj_svømm" c="symje/svømme; NPK prefers symje">
  <!-- See also s/ymje__vblex_adj -->
  <e c="NPK"> <p><l>symj</l><r>symj</r></p></e>
  <e c="v:">  <p><l>svømm</l><r>symj</r></p><par n="v:symje_svømme.stav"/></e>
</pardef>
<pardef n="sum_svøm" c="leggje på sum/svøm; NPK prefers sum">
  <e c="NPK"> <p><l>sum</l>   <r>sum</r></p></e>
  <e c="v:">  <p><l>svøm</l> <r>sum</r></p><par n="v:symje_svømme.stav"/></e>
</pardef>
<pardef n="ønske" c="NPK prefers ønske (eineform)">
  <e c="NPK"> <p><l>ønske</l><r>ønske</r></p></e>
  <e r="LR">  <p><l>ønskje</l><r>ønske</r></p></e>
  <e r="LR">  <p><l>ynskje</l><r>ønske</r></p></e>
  <e r="LR">  <p><l>ynske</l><r>ønske</r></p></e>
</pardef>
<pardef n="tatt" c="NPK prefers teke; see also t/a__vblex_adj">
  <e c="NPK"> <p><l>teke</l><r>tatt</r></p></e>
  <e c="v:">  <p><l>tatt</l><r>tatt</r></p><par n="v:tek_tar.vb-en2tt"/></e>
</pardef>
<pardef n="giv_gjev" c="NPK prefers givande; see also g/je__vblex_adj">
  <e c="NPK"> <p><l>giv</l><r>giv</r></p></e>
  <e c="v:">  <p><l>gjev</l><r>giv</r></p><par n="v:gir_gjev.vb-en2tt"/></e>
  <e c="v:">  <p><l>gjev</l><r>giv</r></p><par n="v:givar_gjevar.stav"/></e>
  <e c="NPK"> <p><l>giv</l><r>gjev</r></p></e>
  <e c="v:">  <p><l>gjev</l><r>gjev</r></p><par n="v:gir_gjev.vb-en2tt"/></e>
  <e c="v:">  <p><l>gjev</l><r>gjev</r></p><par n="v:givar_gjevar.stav"/></e>
</pardef>
<pardef n="liker_likar" c="NPK prefers liker*">
  <e c="NPK"> <p><l>liker</l><r>liker</r></p></e>
  <e c="v:">  <p><l>likar</l><r>liker</r></p><par n="v:brukte_bruka.vb-e2a"/></e>
  <e c="v:">  <p><l>likar</l><r>liker</r></p><par n="v:er_ar.vb-e2a"/></e>
</pardef>
<pardef n="vent" c="NPK prefers tilvent (tilvand)">
  <e c="NPK"> <p><l>vent</l><r>vand</r></p></e>
  <e c="v:">  <p><l>vand</l><r>vand</r></p><par n="v:venne_venje.vb"/></e>
</pardef>
<pardef n="vit" c="NPK prefers vit">
  <e c="NPK"> <p><l>vit</l> <r>vit</r></p></e>
  <e c="v:">  <p><l>vett</l><r>vit</r></p><par n="v:vit_vett"/></e>
</pardef>
<pardef n="gg/ande" c="NPK prefers -ggjande; see also l/igge__vblex_adj">
  <e c="NPK"> <p><l>jande</l><r>ande</r></p></e>
  <e c="v:">  <p><l>ande</l> <r>ande</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="k/ande" c="NPK prefers -kjande; see also avdek/ke__vblex_adj">
  <e c="NPK"> <p><l>jande</l><r>ande</r></p></e>
  <e c="v:">  <p><l>ande</l> <r>ande</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="m/mande" c="NPK prefers -mjande; see also frem/me__vblex_adj">
  <e c="NPK"> <p><l>jande</l><r>mande</r></p></e>
  <e r="LR">  <p><l>mande</l> <r>mande</r></p></e>
  <e r="RL">  <p><l>jande</l> <r>jande</r></p></e>
</pardef>
<pardef n="yng" c="NPK prefers yngj (e.g. klyngje)">
  <e c="NPK"> <p><l>yngj</l><r>yng</r></p></e>
  <e c="v:">  <p><l>yng</l> <r>yng</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="eng" c="NPK prefers engj (e.g. klengje); see also fleng/e__n">
  <e c="NPK"> <p><l>engj</l><r>eng</r></p></e>
  <e c="v:">  <p><l>eng</l> <r>eng</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="venge" c="NPK prefers vengje; see also fleng/e__n">
  <e c="NPK"> <p><l>vengje</l><r>venge</r></p></e>
  <e c="v:">  <p><l>venge</l> <r>venge</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="ølgj_ølg" c="NPK prefers ølgj AND ørgj (e.g. følgje, sørgje); see also fleng/e__n">
  <e c="NPK"> <p><l>ølgj</l><r>ølg</r></p></e>
  <e c="NPK"> <p><l>ølgj</l><r>ølgj</r></p></e>
  <e c="NPK"> <p><l>ørgj</l><r>ørg</r></p></e>
  <e c="v:">  <p><l>ølg</l> <r>ølg</r></p><par n="v:følgje_følge.kons-lgj2lg"/></e>
  <e c="v:">  <p><l>ølg</l> <r>ølgj</r></p><par n="v:følgje_følge.kons-lgj2lg"/></e>
  <e c="v:">  <p><l>ørg</l> <r>ørg</r></p><par n="v:følgje_følge.kons-lgj2lg"/></e>
  <e c="v:">  <p><l>ylgj</l> <r>ølg</r></p><par n="v:følgje_fylgje.vok-ø_gj2y_gj"/></e>
  <e c="v:">  <p><l>ylgj</l> <r>ølgj</r></p><par n="v:følgje_fylgje.vok-ø_gj2y_gj"/></e>
  <e c="v:">  <p><l>yrgj</l> <r>ørg</r></p><par n="v:følgje_fylgje.vok-ø_gj2y_gj"/></e>
</pardef>
<pardef n="ølg_ylg" c="NPK prefers ølg AND ørg (e.g. forfølging, sørging); not 'bylging'">
  <e c="NPK"> <p><l>ølg</l><r>ølg</r></p></e>
  <e c="NPK"> <p><l>ørg</l><r>ørg</r></p></e>
  <e c="v:">  <p><l>ylg</l> <r>ølg</r></p><par n="v:følgje_fylgje.vok-ø_gj2y_gj"/></e>
  <e c="v:">  <p><l>yrg</l> <r>ørg</r></p><par n="v:følgje_fylgje.vok-ø_gj2y_gj"/></e>
</pardef>
<pardef n="lgj_lg" c="NPK prefers lgj (e.g. følgje)">
  <e c="NPK"> <p><l>lgj</l><r>lg</r></p></e>
  <e c="v:">  <p><l>lg</l> <r>lg</r></p><par n="v:følgje_følge.kons-lgj2lg"/></e>
</pardef>
<pardef n="ørgj_ørg" c="NPK prefers ørgj (e.g. sørgjeband)">
  <e c="NPK"> <p><l>ørgj</l><r>ørg</r></p></e>
  <e c="v:">  <p><l>ørg</l> <r>ørg</r></p><par n="v:følgje_følge.kons-lgj2lg"/></e>
  <e c="v:">  <p><l>yrgj</l> <r>ørg</r></p><par n="v:følgje_fylgje.vok-ø_gj2y_gj"/></e>
</pardef>
<pardef n="ygg" c="NPK prefers yggj (e.g. hyggje)">
  <e c="NPK"> <p><l>yggj</l>               <r>ygg</r></p></e>
  <e c="v:">  <p><l>ygg</l>                <r>ygg</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="igg" c="NPK prefers iggj (e.g. liggje)">
  <e c="NPK"> <p><l>iggj</l>               <r>igg</r></p></e>
  <e c="v:">  <p><l>igg</l>                <r>igg</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
