<pardef n="bønn" c="NPK prefers bønn">
  <e c="NPK"> <p><l>bønn</l><r>bønn</r></p></e>
  <e r="LR">  <p><l>bøn</l><r>bønn</r></p></e>
</pardef>
<pardef n="bilde" c="NPK prefers bilet- (but lemma is bilde-)
                     Only use for left-parts of compounds like 'biletskjønn';
                     words like 'stjernebilde' use par n='bil/de__n'.">
  <e c="NPK"> <p><l>bilet</l><r>bilde</r></p></e>
  <e r="LR">  <p><l>bilde</l> <r>bilde</r></p></e>
  <e c="v:">  <p><l>bilde</l><r>bilde</r></p><par n="v:bilete_bilde.syn"/></e>
  <e r="LR" c="typo"><p><l>bilete</l> <r>bilde</r></p></e>
</pardef>
<pardef n="lønn" c="NPK prefers lønn">
  <e c="NPK"> <p><l>lønn</l><r>lønn</r></p></e>
  <e c="v:">  <p><l>løn</l><r>lønn</r></p><par n="v:venn_ven.kons-mm2m"/></e>
</pardef>
<pardef n="skot" c="NPK prefers skot(?)">
  <e c="NPK"> <p><l>skot</l><r>skot</r></p></e>
  <e r="LR">  <p><l>skott</l><r>skot</r></p></e>
  <e c="v:">  <p><l>skott</l><r>skot</r></p><par n="v:brot_brott.kons-t2tt"/></e>
</pardef>
<pardef n="visning" c="NPK prefers visning">
  <e c="NPK"> <p><l>visning</l><r>visning</r></p></e>
  <e c="v:">  <p><l>vising</l><r>visning</r></p><par n="v:forvaltning_forvalting.afx-ning2ing"/></e>
</pardef>
<pardef n="komme" c="NPK prefers komme">
  <!-- See also k/omme__vblex_adj and /komme__n -->
  <e c="NPK"> <p><l>komme</l><r>komme</r></p></e>
  <e c="v:">  <p><l>kome</l><r>komme</r></p><par n="v:komme_kome.kons-mm2m"/></e>
  <e c="v:">  <p><l>kome</l><r>komme</r></p><par n="v:venn_ven.kons-mm2m"/></e>
</pardef>
