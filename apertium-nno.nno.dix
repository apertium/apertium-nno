    <!-- Verb metaparadigms -->
<pardef n="a_vs_e" c="Adds nothing to r element!">
  <e>       <p><l>a</l> <r></r></p></e>
  <e c="v:"><p><l>e</l> <r></r></p><par n="v:infa_infe"/></e>
</pardef>
<pardef n="a_vs_e__vblex_inf_cp-both" c="Adds nothing to lemma-part of r element!
                                      Only -e- in compound-left; -a- is not productive outside Rogaland :)">
  <e>       <p><l></l>               <r><s n="vblex"/><s n="inf"/></r></p><par n="a_vs_e"/><par n="cp-R"/></e>
  <e>       <p><l>e</l>              <r><s n="vblex"/><s n="inf"/></r></p><par n="cp-L"/></e>
</pardef>
<pardef n="a_vs_e__vblex_inf_no-cp" c="as above, for no-cp pardefs">
  <e>       <p><l></l>               <r><s n="vblex"/><s n="inf"/></r></p><par n="a_vs_e"/><par n="no-cp-R"/></e>
  <e r="RL"><p><l>e</l>     <r><s n="vblex"/><s n="inf"/></r></p><par n="cp-L"/></e>
</pardef>

