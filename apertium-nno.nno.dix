<dictionary>
  <!--
    Generated semi-automatically from the Norsk ordbank.
    http://www.edd.uio.no/prosjekt/ordbanken/

    Grep for "todo" if you’re looking for work.

    Some of the stuff in this file that is still very much work-in-progress
    or barely begun:

    - Spelling choice pardefs, see eg. pardef n="høyr_LR_hør"

    - Genitives. Still some words ending in s/z/x need new ’-genitive
      pardefs; similarly ’s for acronyms

    Like a lot of the Scandinavian/Germanic Apertium dictionaries,
    this dictionary has:

    - Multiword / separable verb with "rå til" and "høyre til",
      see https://wiki.apertium.org/wiki/Norsk#Multiword_expressions.2C_particle_verbs

    - Compounding. Most noun pardefs refer to the pardefs "cp-R" and "cp-both-s",

 -->
  <alphabet>ABCDEFGHIJKLMNOPQRSTUVWXYZÆØÅabcdefghijklmnopqrstuvwxyzæøåcqwxzCQWXZéèêóòâôÉÊÈÓÔÒÂáàÁÀäÄöÖšŠčČðđÐýÝñÑüÜíÍıİËë-0123456789̇</alphabet>
  <sdefs>
    <sdef n="n" 	c="Noun"/>
    <sdef n="np" 	c="Proper noun"/>
    <sdef n="top"   c="Toponym"/>
    <sdef n="ant"   c="Anthroponym"/>
    <sdef n="cog"   c="Cognomen"/>
    <sdef n="org"  c="Organisation"/>
    <sdef n="al"  c="Altres / misc proper nouns"/>
    <sdef n="init"  c="Initials"/>
    <sdef n="tm"    c="Trademark, type/model name"/>
    <sdef n="attr"  c="Attributive (certain proper nouns)"/>
    <sdef n="prn" 	c="Pronoun"/>
    <sdef n="pers" 	c="Personal pronoun"/>
    <sdef n="ref" 	c="Reflexive pronoun"/>
    <sdef n="rel" 	c="Relative pronoun (RL-only)"/>
    <sdef n="res" 	c="Reciprocal pronoun"/>
    <sdef n="det" 	c="Determiner"/>
    <sdef n="pos" 	c="Possessive"/>
    <sdef n="p1" 	c="1st person"/>
    <sdef n="p2" 	c="2nd person"/>
    <sdef n="p3" 	c="3rd person"/>
    <sdef n="nt" 	c="Neuter"/>
    <sdef n="mf" 	c="Masculine / feminine, also utrum in nouns"/>
    <sdef n="f" 	c="Feminine"/>
    <sdef n="m" 	c="Masculine"/>
    <sdef n="un" 	c="No gender"/>
    <sdef n="sp" 	c="Singular / plural"/>
    <sdef n="sg" 	c="Singular"/>
    <sdef n="du" 	c="Dual (generation only)"/>
    <sdef n="pl" 	c="Plural"/>
    <sdef n="ind" 	c="Indefinite"/>
    <sdef n="def" 	c="Definite"/>
    <sdef n="nom" 	c="Nominative"/>
    <sdef n="acc" 	c="Accusative"/> <!-- the oblique case -->
    <sdef n="gen" 	c="Genitive"/>
    <sdef n="dem" 	c="Demonstrative"/>
    <sdef n="itg" 	c="Question word / interrogative"/>
    <sdef n="qnt" 	c="Quantifier"/>
    <sdef n="neg" 	c="Negative"/>
    <sdef n="emph" 	c="Emphatic"/>
    <sdef n="vblex" 	c="Verb"/>
    <sdef n="pasv" 	c="-st form"/>
    <sdef n="pstv" 	c="-st verb"/>
    <sdef n="inf" 	c="Infinitive"/>
    <sdef n="pres" 	c="Present"/>
    <sdef n="imp" 	c="Imperative"/>
    <sdef n="pret" 	c="Preterite"/>
    <sdef n="pp" 	c="Perfect participle (vblex/adj)"/>
    <sdef n="pprs" 	c="Present participle (adjectival)"/>
    <sdef n="pr" 	c="Preposition"/>
    <sdef n="adv" 	c="Adverb"/>
    <sdef n="ij" 	c="Interjection"/>
    <sdef n="adj" 	c="Adjective"/>
    <sdef n="sint" 	c="Synthetic (of adjectives)"/>
    <sdef n="part" 	c="Participle (infinitive)"/>
    <sdef n="cnjsub" 	c="Subordinating conjunction"/>
    <sdef n="cnjcoo" 	c="Co-ordinating conjunction"/>
    <sdef n="cnjadv" 	c="Adverbial conjunction"/>
    <sdef n="pst" 	c="Positive"/>
    <sdef n="comp" 	c="Comparative"/>
    <sdef n="sup" 	c="Superlative"/>
    <sdef n="xpst"    c="Positive derivative"/>
    <sdef n="xpsts"   c="Positive derivative of synthetics"/>
    <sdef n="xpsto"   c="Positive derivative of ordinals"/>
    <sdef n="xcomp"   c="Comparative derivative"/>
    <sdef n="xsup"    c="Superlative derivative"/>
    <sdef n="ord" 	c="Ordinal"/>
    <sdef n="acr" 	c="Acronym"/>
    <sdef n="expl" 	c="Syntactic expletive"/>
    <sdef n="unc"   c="Uncountable"/>
    <sdef n="sent" 	c="Sentence end"/>
    <sdef n="cm" 	c="Comma"/>
    <sdef n="apos" 	c="Apostrophe"/>
    <sdef n="clb" 	c="Possible clause boundary"/>
    <sdef n="overskrift" 	c="Headline"/>
    <sdef n="lpar" 	c="Left parenthesis"/>
    <sdef n="rpar" 	c="Right parenthesis"/>
    <sdef n="lquot" 	c="Left quote"/>
    <sdef n="rquot" 	c="Right quote"/>
    <sdef n="date"      c="Dates, years"/>
    <sdef n="url" 	c="URL/E-mail"/>

    <sdef n="guess" 	c="Guesser"/>
    <sdef n="cgguess" 	c="CG Guesser"/>

    <sdef n="compound-only-L" 	c="May only be the left-side of a compound"/>
    <sdef n="compound-R" 	c="May be the right-side of a compound, or a full word"/>
    <sdef n="cmp" 	c="Generation only: added by transfer to say we have a compound"/>
    <sdef n="guio" 	c="Dash, also: Generation only-mark added by transfer to say we should add a dash (e.g. for split compounds)"/>
    <!-- <sdef n="detriple" 	c="Left part of a compound where the double consonant is turned single (by composing with detriple.dix)"/> -->
    <sdef n="cmp-split" 	c="Left part of a split compound"/>

    <sdef n="remspc" c="Tell transfer to remove preceding space"/>

    <sdef n="v:tenkje-leggje.kons-kj2k_gj2g"         c="Variant: Use k/g instead of kj/gj (leggje→legge, tenkje→tenke)"/>
    <sdef n="v:enkje_enke.kons-kj2k_gj2g"            c="Variant: Use k/g instead of kj/gj, only in f/nt nouns (bryggje→brygge, rekkje→rekke, bryggjeri→bryggeri, spøkjelse→spøkelse)"/>
    <sdef n="v:følgje_følge.kons-lgj2lg"             c="Variant: Use lg instead of lgj (følgje→følge, svelgje→svelge)"/>
    <sdef n="v:følgje_fylgje.vok-ø_gj2y_gj"     c="Variant: Use y+gj instead of ø+gj (følgje→fylgje, sørgje→syrgje), relating to først_fyrst.vok-ø2y"/>
    <sdef n="v:kjende_kjente.vb-d2t"     c="Variant: Use pret and pp -te/-t instead of -de/-d (kjende→kjente, brende→brente, dømde→dømte)"/>
    <sdef n="v:bygd_bygt.vb-d2t"     c="Variant: Use pp ending -t instead of -d (supinum + nt); (bygd→bygt (byggje), budd→butt (bu))"/>
    <sdef n="v:de_dokker.prn"    c="Variant: Use dokker instead of de"/>
    <sdef n="v:medan_mens.syn"   c="Variant: Use mens instead of medan"/>
    <sdef n="v:infa_infe"    c="Variant: Use e-inf instead of a-inf"/>
    <sdef n="v:me_vi"        c="Variant: Use vi instead of me"/>
    <sdef n="v:er_ar.vb-e2a"        c="Variant: Use mixed inflection -ar/-te/-t instead of -er/-te/-t where possible (koker→kokar)"/>
    <sdef n="v:brukte_bruka.vb-e2a"  c="Variant: Use optional inflection -ar -a (v1) instead of -er -te (v2)"/>
    <sdef n="v:håpa_håpte.vb-e2a"    c="Variant: Use optional inflection -er -te (v2) instead of -ar -a (v1)"/>
    <sdef n="v:tek_tar.vb-en2tt"     c="Variant: Use tar/tatt instead of tek/teken"/>
    <sdef n="v:gir_gjev.vb-en2tt"    c="Variant: Use gjev/gjeven instead of gir/gitt"/>
    <sdef n="v:givar_gjevar.stav"    c="Variant: Use -gjevar instead of -giver"/>
    <sdef n="v:dreg_drar.vb-en2tt"   c="Variant: Use drar/dratt instead of dreg/dregen"/>
    <sdef n="v:dratt_dradd.vb-en2tt" c="Variant: Use pp/adj dradd instead of dratt/dregen"/>
    <sdef n="v:eigde_åtte.vb"      c="Variant: Use åtte instead of eigde"/>
    <sdef n="v:venne_venje.vb"      c="Variant: Use venje instead of venne"/>
    <sdef n="v:vart-vorte_blei-blitt.vb-bli2verte"    c="Variant: Use blei/blitt instead of vart/vorte"/>
    <sdef n="v:vart-vorte_vart-blitt.vb-bli2verte"    c="Variant: Use blitt instead of vorte, keep vart"/>
    <sdef n="v:bli_verte.vb-bli2verte"    c="Variant: Use verte/vert instead of bli/blir, keep vart/vorte"/>
    <sdef n="v:stader_stadar.n-pl-e2a"    c="Variant: Use plural -ar/-ane instead of -er/-ene in maskuline nouns"/>
    <sdef n="v:elvar_elver.n-pl-e2a"      c="Variant: Use plural -er/-ene instead of -ar/-ane in feminine nouns"/>
    <sdef n="v:vit_vett"     c="Variant: Use ~vett instead of ~vit"/>
    <sdef n="v:brot_brott.kons-t2tt"     c="Variant: Use ~brott and ~skott instead of ~brot and ~skot"/>
    <sdef n="v:voks_vaks.vok-o2a"    c="Variant: Use vaks instead of voks (pret)"/>
    <sdef n="v:barna_borna.vok-o2a"  c="Variant: Use born – borna instead of barn – barna (pl)"/>
    <sdef n="v:maske_moske.vok-o2a"  c="Variant: Use moske instead of maske (garnmaske)"/>
    <sdef n="v:oske_aske.vok-o2a"  c="Variant: Use aske, askeladd instead of oske, oskeladd; NB: aske not approved"/>
    <sdef n="v:trost_trast.vok-o2a"  c="Variant: Use trast (f) instead of trost (m)"/>
    <sdef n="v:mengd_mengde.vok-2e" c="Variant: Use mengde/lengde/… instead of mengd/lengd/…"/>
    <sdef n="v:blå_blåe.adj"     c="Variant: Use blåe/gråe/… instead of blå/grå/…"/>
    <sdef n="v:lét_let"      c="Variant: Use let/let instead of lét/lèt"/>
    <sdef n="v:blæs_blåser.vb"      c="Variant: Use blåser – blåste – blåst instead of blæs - bles – blåse "/>
    <sdef n="v:skule_skole.vok-u2o"  c="Variant: Use skole instead of skule"/>
    <sdef n="v:skolere_skulere.vok-u2o"  c="Variant: Use skulere instead of skolere"/>
    <sdef n="v:jul_jol.vok-u2o"  c="Variant: Use jol instead of jul"/>
    <sdef n="v:sommar_sumar.vok-o2u"  c="Variant: Use sumar instead of sommar"/>
    <sdef n="v:stove_stue.vok-u2o"  c="Variant: Use stue instead of stove"/>
    <sdef n="v:høvding_hovding.vok-ø2o"  c="Variant: Use o instead of ø: høvding/hovding, røde/rode, strøkne/strokne, tørste/torste"/>
    <sdef n="v:kors_kross.stav"   c="Variant: Use kross instead of kors"/>
    <sdef n="v:venn_ven.kons-mm2m"   c="Variant: Use dommar, skjøne instead of dommar, skjønne; includes kome, -domen and kjøt"/>
    <sdef n="v:komme_kome.kons-mm2m"   c="Variant: Use kome instead of komme"/>
    <sdef n="v:dommen_domen.kons-mm2m"   c="Variant: Use alderdomen, kongedøme, ungdomleg instead of alderdommen, kongedømme, ungdommeleg"/>
    <sdef n="v:kjøtt_kjøt.kons-mm2m"   c="Variant: Use kjøt, kjøken instead of kjøtt, kjøkken"/>
    <sdef n="v:mogleg_mogeleg.vok-2e"   c="Variant: Use mogeleg, vitskapeleg instead of mogleg, vitskapleg"/>
    <sdef n="v:nærare_nærmare.stav" c="Variant: Use nærare instead of nærmare"/>
    <sdef n="v:eigentleg_eigenleg.stav" c="Variant: Use eigentleg instead of eigenleg"/>
    <sdef n="v:styresmakt_styremakt.stav" c="Variant: Use styremakt instead of styresmakt"/>
    <sdef n="v:true_truge.stav" c="Variant: Use truge, trugsel instead of true, trussel"/>
    <sdef n="v:symje_svømme.stav" c="Variant: Use svømme, svømmar instead of symje, symjar"/>
    <sdef n="v:døgn_døger.stav" c="Variant: Use døger, døgeret, døgera instead of døgn, døgnet, døgna"/>
    <sdef n="v:augne_auge.stav" c="Variant: Use auge- instead of augne-"/>
    <sdef n="v:auga_augo.vok-a2o" c="Variant: Use auga - augo instead of auge - auga (øyre, hjarte)"/>
    <sdef n="v:linje_line.stav" c="Variant: Use line instead of linje"/>
    <sdef n="v:brud_brur.stav" c="Variant: Use brur instead of brud"/>
    <sdef n="v:då_da.vok-a2å"        c="Variant: Use da instead of då, enda/endå"/>
    <sdef n="v:åleine_aleine.vok-a2å"        c="Variant: Use aleine instead of åleine"/>
    <sdef n="v:allmenn_ålmenn.vok-a2å"        c="Variant: Use ålmenn instead of allmenn (klar/klår, skap/skåp etc."/>
    <sdef n="v:no_nå.vok-o2å"        c="Variant: Use nå instead of no, ennå/enno"/>
    <sdef n="v:så_so.vok-o2å"        c="Variant: Use so instead of så, også/ogso, altså/also, nokså/nokso"/>
    <sdef n="v:først_fyrst.vok-ø2y"        c="Variant: Use y instead of ø, søster/syster, ønske/ynske, sølv/sylv etc."/>
    <sdef n="v:søndag_sundag.vok-ø2u"      c="Variant: Use u instead of ø, søndag/sundag, tørke/turke"/>
    <sdef n="v:lykke_lukke.vok-y2u"        c="Variant: Use u instead of y, lykke/lukke, skyve/skuve, krybbe/krubbe"/>
    <sdef n="v:fjøre_fjære.vok-ø2æ"        c="Variant: Use æ instead of ø, fjøre/fjære, tjøre/tjære"/>
    <sdef n="v:dess-der_di.afx"  c="Variant: Use di instead of dess/der, dessverre/diverre"/>
    <sdef n="v:der_di.afx"  c="Variant: Use di instead of der, dermed/dimed, dernest/dinest"/>
    <sdef n="v:fly_flyge.vb-inf"    c="Variant: Use flyge instead of fly (inf)"/>
    <sdef n="v:flyg_flyr.vb-inf"    c="Variant: Use flyg instead of flyr (pres), incompatible with flyge (inf)"/>
    <sdef n="v:gle_glede.vb-inf"    c="Variant: Use glede-gleder instead of gle-gler (inf + pres)"/>
    <sdef n="v:lide_li.vb-inf"      c="Variant: Use li-lir-lei instead of lide-lid-leid (inf + pres + pret, suffer)"/>
    <sdef n="v:jern_jarn.vok-a2e"    c="Variant: Use jern instead of jarn"/>
    <sdef n="v:kvalp_kvelp.vok-a2e"    c="Variant: Use kvelp instead of kvalp"/>
    <sdef n="v:anten_enten.vok-a2e"    c="Variant: Use enten instead of anten"/>
    <sdef n="v:aftan_eftan.vok-a2e"    c="Variant: Use eftan instead of aftan"/>
    <sdef n="v:alter_altar.vok-a2e"    c="Variant: Use altar instead of alter"/>
    <sdef n="v:spenn_span.vok-a2e"    c="Variant: Use spanande instead of spennande"/>
    <sdef n="v:drikk_drykk.vok-i2y"    c="Variant: Use drykk instead of drikk"/>
    <sdef n="v:segle_sigle.vok-e2i"    c="Variant: Use i instead of e, segle/sigle, ekorn/ikorn"/>
    <sdef n="v:krins_krets.syn"          c="Variant: Use krets instead of krins"/>
    <sdef n="v:bilete_bilde.syn"          c="Variant: Use bilde instead of bilete"/>
    <sdef n="v:lys_ljos.vok-y2jo"      c="Variant: Variant: Use jo instead of y: lyd/ljod, lys/ljos"/>
    <sdef n="v:nød_naud.dift-ø2au"     c="Variant: Use au instead of ø, nød/naud, løk/lauk, løp/laup, døv/dauv etc."/>
    <sdef n="v:dødeleg_døyeleg.dift-ø2øy"     c="Variant: Use øy instead of ø, dødeleg/døyeleg, mør/møyr, skjør/skøyr etc."/>
    <sdef n="v:pek_peik.dift-e2ei"     c="Variant: Use ei instead of e, fingerpek/fingerpeik, skolest/skoleist etc."/>
    <sdef n="v:setje_sette.kons-tj2tt"        c="Variant: Use tt instead of tj, setje/sette, sitje/sitte"/>
    <sdef n="v:fremje_fremme.kons-mj2mm"        c="Variant: Use mm instead of mj, fremje/fremme, fremjing/fremming"/>
    <sdef n="v:hemme_hemje.kons-mm2mj"        c="Variant: Use mj instead of mm, hemme/hemje, hemming/hemjing"/>
    <sdef n="v:gremme_gremje.kons-mm2mj"        c="Variant: Use mj instead of mm, gremme/gremje"/>
    <sdef n="v:formål_føremål.afx-fore2føre"   c="Variant: Use prefix føre- instead of for(e)-, føremål, føredrag instead of formål, føredrag"/>
    <sdef n="v:forvaltning_forvalting.afx-ning2ing"   c="Variant: Use suffix -ing instead of -ning, avkasting, underhalding instead of avkastning, underhaldning"/>
    <sdef n="v:redsel_redsle.kons-sel2sle"   c="Variant: Use suffix -sle (f) instead of -sel (m), redsle instead of redsel; see also nno-nob"/>
    <sdef n="v:gløymsle_gløymsel.kons-sel2sle"   c="Variant: Use suffix -sel (m) instead of -sle (f), gløymsel instead of gløymsle; see also nno-nob"/>
    <sdef n="v:apos_fot.teikn"    c="Variant: Use foot symbol (') instead of real apostrophe (’)"/>
    <sdef n="v:sitat_tomme.teikn" c="Variant: Use inch symbol (&quot;) instead of real quotation marks (“/”)"/>
  </sdefs>
  <pardefs>


<pardef n="v:tenkje-leggje.kons-kj2k_gj2g">
