  <e c="NPK"> <p><l>eggj</l>               <r>egg</r></p></e>
  <e c="v:">  <p><l>egg</l>                <r>egg</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="eg/gar" c="NPK prefers gjar (e.g. byggjar); see also fleng/e__n">
  <e c="NPK"> <p><l>gjar</l><r>gar</r></p></e>
  <e c="v:">  <p><l>gar</l> <r>gar</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="sø/kar" c="NPK prefers kjar (e.g. søkjar)">
  <e c="NPK"> <p><l>kjar</l><r>kar</r></p></e>
  <e c="v:">  <p><l>kar</l> <r>kar</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="spø/ke" c="NPK prefers spøkjelse">
  <e c="NPK"> <p><l>kje</l><r>ke</r></p></e>
  <e c="v:">  <p><l>ke</l> <r>ke</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="kj_k" c="NPK prefers ønskjeliste; lemma is without -j- for simpler scandi bidix">
  <e c="NPK"> <p><l>kj</l><r>k</r></p></e>
  <e c="v:">  <p><l>k</l> <r>k</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="gj_g" c="NPK prefers byggjesøknad; lemma is without -j- for simpler scandi bidix">
  <e c="NPK"> <p><l>gj</l><r>g</r></p></e>
  <e c="v:">  <p><l>g</l> <r>g</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="kj_k_sub" c="f and nt nouns separate or included, NPK prefers enkje">
  <e c="NPK"> <p><l>kj</l><r>k</r></p></e>
  <e c="v:">  <p><l>k</l> <r>k</r></p><par n="v:enkje_enke.kons-kj2k_gj2g"/></e>
  <e c="v:">  <p><l>k</l> <r>k</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="gj_g_sub" c="f and nt nouns separate or included, NPK prefers bryggjeri">
  <e c="NPK"> <p><l>gj</l><r>g</r></p></e>
  <e c="v:">  <p><l>g</l> <r>g</r></p><par n="v:enkje_enke.kons-kj2k_gj2g"/></e>
  <e c="v:">  <p><l>g</l> <r>g</r></p><par n="v:tenkje-leggje.kons-kj2k_gj2g"/></e>
</pardef>
<pardef n="kors" c="NPK prefers kors">
  <e c="NPK"><p><l>kors</l>  <r>kors</r></p></e>
  <e c="v:"> <p><l>kross</l> <r>kors</r></p><par n="v:kors_kross.stav"/></e>
  <e r="LR"> <p><l>kross-</l><r>kors</r></p></e> <!-- for analysing compounds like kross-saum -->
</pardef>
<pardef n="nær" c="NPK prefers nærare">
  <e c="NPK"> <p><l>nær</l>               <r>nær</r></p></e>
  <e c="v:">  <p><l>nærm</l>              <r>nær</r></p><par n="v:nærare_nærmare.stav"/></e>
</pardef>
