  <e c="v:">  <p><l>g</l> <r>g</r></p><par n="v:true_truge.stav"/></e>
</pardef>
<pardef n="__e" c="mogleg/mogeleg; NPK prefers mogleg">
  <e c="NPK"> <p><l></l>   <r></r></p></e>
  <e c="v:">  <p><l>e</l>  <r></r></p><par n="v:mogleg_mogeleg.vok-2e"/></e>
</pardef>
<pardef n="flaum" c="flaum is mandatory, allow flom as input">
  <!-- See also fl/aum__n -->
  <e r="LR">  <p><l>flom</l><r>flaum</r></p></e>
